{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "brettsmith",
  "compatibility_date": "2025-04-04",
  "keep_vars": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "routes": [
    {
      "pattern": "brettsmith.me",
      "custom_domain": true,
    },
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
}
