---
import { execSync } from "node:child_process";
import { SOCIAL_LINKS } from "../constants/seo.constants";
import { cn } from "../helpers/cn";
import { linkText } from "../styles/text.styles";
import LogoMark from "./LogoMark.astro";

const commitHash = execSync("git rev-parse HEAD", { encoding: "utf8" }).trim();
const commitMessage = execSync("git log -1 --format=%s", {
  encoding: "utf8",
}).trim();
const repositoryUrl = "https://github.com/jbsmith731/brettsmith.astro";
const commitUrl = `${repositoryUrl}/commit/${commitHash}`;
---

<footer class="mt-8 border-t border-border-soft bg-surface-subtle">
  <div class="container">
    <div
      class={cn(
        "grid gap-8",
        "sm:grid-cols-[1fr_auto] md:grid-cols-[1fr_auto_auto] sm:items-start",
        "py-8 md:py-10",
      )}
    >
      <div class="grid gap-2">
        <div>
          <LogoMark />
        </div>
        <p class="max-w-[25ch] text-sm text-text-muted">
          Software engineer building useful things for the web.
        </p>
      </div>

      <div class="grid grid-cols-2 gap-x-6 md:contents">
        <nav
          aria-label="Internal navigation"
          class="flex flex-col items-start gap-3 text-sm"
        >
          <a href="/reading" class={linkText({ color: "primary" })}>
            Reading
          </a>
          <a href="/bookmarks" class={linkText({ color: "primary" })}>
            Bookmarks
          </a>
          <a href="/design" class={linkText({ color: "primary" })}>
            Design system
          </a>
        </nav>

        <nav
          aria-label="External links"
          class="flex flex-col items-start gap-3 text-sm md:ml-8"
        >
          <a
            href="mailto:hi@brettsmith.me"
            class={cn(
              linkText({ color: "primary" }),
              "inline-flex items-center gap-1",
            )}
          >
            Contact
            <span aria-hidden="true" class="text-text-muted">
              ↗
            </span>
          </a>
          {SOCIAL_LINKS.map((link) => (
            <a
              href={link.url}
              target="_blank"
              rel="noopener noreferrer"
              class={cn(
                linkText({ color: "primary" }),
                "inline-flex items-center gap-1",
              )}
            >
              {link.name}
              <span aria-hidden="true" class="text-text-muted">
                ↗
              </span>
            </a>
          ))}
        </nav>
      </div>
    </div>

    <div
      class={cn(
        "flex flex-col gap-3 border-t border-border-soft",
        "py-4 text-xs",
        "sm:flex-row sm:items-center sm:justify-between",
      )}
    >
      <div class="flex flex-wrap items-center gap-x-5 gap-y-3 text-sm">
        <a
          href={commitUrl}
          target="_blank"
          rel="noopener noreferrer"
          class={cn(
            linkText({ color: "primary" }),
            "inline-flex max-w-full items-center gap-1",
          )}
        >
          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            fill="none"
            class="size-4 shrink-0 stroke-current text-text-muted"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M6 6v4m0 4v4" />
            <path d="M8 12h3a5 5 0 0 0 5-5" />
            <circle cx="6" cy="4" r="2" />
            <circle cx="6" cy="12" r="2" />
            <circle cx="6" cy="20" r="2" />
            <circle cx="16" cy="7" r="2" />
          </svg>
          <span
            class="min-w-0 truncate font-mono text-xs"
            title={commitMessage}
          >
            {commitMessage}
          </span>
          <span class="font-mono text-xs">{commitHash.slice(0, 7)}</span>
          <span aria-hidden="true" class="text-text-muted">
            ↗
          </span>
        </a>
        <!-- <a
          href={repositoryUrl}
          target="_blank"
          rel="noopener noreferrer"
          class={cn(
            linkText({ color: "primary" }),
            "inline-flex items-center gap-1",
          )}
        >
          View source
          <span aria-hidden="true" class="text-text-muted">
            ↗
          </span>
        </a> -->
      </div>

      <span class="font-mono uppercase tracking-wider text-text-muted">
        &copy; {new Date().getFullYear()} Brett Smith
      </span>
    </div>
  </div>
</footer>
