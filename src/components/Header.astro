---
import { twMerge } from 'tailwind-merge';
import { linkText } from '../styles/text.styles';
---

<header class="sticky top-0 z-50 backdrop-blur-lg">
	<div class="container flex h-16 items-center justify-between">
		<a
			href="/"
			class={twMerge('relative after:absolute after:-inset-2 text-ds-neutral-950 transition-colors hover:text-ds-neutral-500')}
		>
			<svg xmlns="http://www.w3.org/2000/svg" width="20" height="18" fill="none" viewBox="0 0 20 18" aria-hidden="true">
				<path fill="currentColor" d="M0 17.16V0h8.328c3.576 0 5.448 1.392 5.448 4.32 0 2.112-1.248 3.168-2.664 3.648v.048c1.8.312 3.336 1.512 3.336 4.08 0 3.648-2.328 5.064-5.88 5.064zM4.32 6.936H7.2c1.2 0 2.16-.288 2.16-1.704S8.4 3.528 7.2 3.528H4.32zm0 6.696h3c1.8 0 2.712-.432 2.712-2.04S9.12 9.576 7.32 9.576h-3z" />
				<circle cx="18" cy="15" r="2" fill="var(--color-accent)" />
			</svg>
			<span class="sr-only">Home</span>
		</a>

		<nav aria-label="Main navigation">
			<ul class="flex gap-6">
				<li><a href="/bookmarks" class={twMerge(linkText({ color: 'primary' }), 'aria-[current=page]:line-through decoration-accent decoration-[1.5px]')} aria-current={Astro.url.pathname === '/bookmarks' ? 'page' : undefined}>Bookmarks</a></li>
				<li><a href="mailto:hi@brettsmith.me" class={linkText({ color: 'primary' })}>Contact</a></li>
			</ul>
		</nav>
	</div>
</header>
