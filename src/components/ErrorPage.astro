---
import { heading, text } from '../styles/text.styles';

interface Props {
	headingText?: string;
	message?: string;
}

const {
	headingText = 'An error occurred',
	message = 'Something went wrong.',
} = Astro.props;
---

<main class="container grid place-content-center gap-2 text-center">
	<h1 class={heading({ level: 'h1', weight: 'regular' })}>{headingText}</h1>
	<p class={text()}>{message}</p>
	<a
		href="/"
		class="place-self-center rounded-lg bg-ds-neutral-800 px-4 py-2.5 text-sm font-medium text-ds-neutral-50 transition-colors hover:bg-ds-neutral-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2"
	>
		Go back Home
	</a>
</main>
