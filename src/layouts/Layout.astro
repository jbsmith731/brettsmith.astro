---
import "../styles/global.css";
import uncutSans from "../assets/fonts/UncutSans-Variable.woff2";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { TITLE, DESCRIPTION } from "../constants/seo.constants";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = TITLE,
  description = DESCRIPTION,
  noindex = true,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="preload"
      href={uncutSans}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="root grid min-h-dvh grid-rows-[auto_1fr_auto] bg-surface text-text-primary">
    <Header />
    <slot />
    <Footer />
  </body>
</html>
