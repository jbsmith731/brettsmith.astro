---
import Layout from "../layouts/Layout.astro";
import Main from "../components/Main.astro";
import { cn } from "../helpers/cn";
import { createMetaTitle } from "../helpers/seo.helpers";
import PageHero from "../components/PageHero.astro";
import { heading, label, text } from "../styles/text.styles";

const description =
  "A reference for the fonts, colors, and typography used across Brett Smith’s website.";
const eyebrow = `${label} ${text({ size: "xs", color: "secondary" })}`;

const palettes = [
  {
    name: "Cobalt",
    description: "The primary accent for links, focus, and interactive states.",
    shades: [
      ["50", "#eff3ff"],
      ["100", "#dfe7ff"],
      ["200", "#c4d2ff"],
      ["300", "#9db5ff"],
      ["400", "#7292ff"],
      ["500", "#4b73f5"],
      ["600", "#315fea"],
      ["700", "#254bc7"],
      ["800", "#203ea1"],
      ["900", "#1e347d"],
      ["950", "#172653"],
    ],
  },
  {
    name: "Neutral",
    description: "A quiet green gray scale for surfaces, text, and borders.",
    shades: [
      ["50", "#f4f5f3"],
      ["100", "#dde1dc"],
      ["200", "#d0d5cf"],
      ["300", "#b8beb7"],
      ["400", "#858a85"],
      ["500", "#686e68"],
      ["600", "#515751"],
      ["700", "#3c423d"],
      ["800", "#222522"],
      ["900", "#191c19"],
      ["950", "#101210"],
    ],
  },
] as const;

const typeSamples = [
  {
    name: "Heading 1",
    level: "h1",
    detail: "30 / 1.1 → 48 / 1.05 · 400",
    sample: "Thoughtful software, made well.",
  },
  {
    name: "Heading 2",
    level: "h2",
    detail: "30 / 1.1 → 36 / 1.1 · 400",
    sample: "A clear point of view.",
  },
  {
    name: "Heading 3",
    level: "h3",
    detail: "30 / 1.1 · 500",
    sample: "Details make the difference.",
  },
  {
    name: "Heading 4",
    level: "h4",
    detail: "24 / 1.15 · 500",
    sample: "Built for people.",
  },
  {
    name: "Heading 5",
    level: "h5",
    detail: "20 / 1.25 · 500",
    sample: "Good work starts with clarity.",
  },
  {
    name: "Heading 6",
    level: "h6",
    detail: "16 / 1.25 · 500",
    sample: "A useful detail.",
  },
  {
    name: "Body",
    textSize: "default",
    detail: "16 / 1.5 · 400",
    sample:
      "Good interfaces make complex things feel simple. They give content room to breathe and make the next step easy to find.",
  },
  {
    name: "Small",
    textSize: "sm",
    detail: "14 / 1.4 · 400",
    sample: "Supporting text and secondary descriptions.",
  },
] as const;

const semanticColors = [
  {
    name: "Subtle surface",
    token: "--color-surface-subtle",
    palette: "Neutral 50 · Neutral 950",
    usage: "Quiet backgrounds",
  },
  {
    name: "Surface",
    token: "--color-surface",
    palette: "White · Neutral 900",
    usage: "Cards & panels",
  },
  {
    name: "Soft border",
    token: "--color-border-soft",
    palette: "Neutral 100 · Neutral 800",
    usage: "Subtle separators",
  },
  {
    name: "Border",
    token: "--color-border",
    palette: "Neutral 200 · Neutral 700",
    usage: "Defined boundaries",
  },
  {
    name: "Primary text",
    token: "--color-text-primary",
    usage: "Primary copy",
    palette: "Neutral 900 · Neutral 50",
  },
  {
    name: "Muted text",
    token: "--color-text-muted",
    palette: "Neutral 500 · Neutral 300",
    usage: "Secondary copy",
  },
  {
    name: "Accent",
    token: "--color-accent",
    palette: "Cobalt 600 · Cobalt 400",
    usage: "Links & actions",
  },
  {
    name: "Accent hover",
    token: "--color-accent-hover",
    palette: "Cobalt 700 · Cobalt 300",
    usage: "Hovered links & actions",
  },
] as const;

const characterSet = [
  "ABCDEFGHIJKLMNOPQRSTUVWXYZ",
  "abcdefghijklmnopqrstuvwxyz",
  "0123456789",
];

const fontCards = [
  {
    role: "Primary typeface",
    name: "Uncut Sans",
    description:
      "The voice of the interface: clear, warm, and quietly expressive.",
    style: "Variable sans serif",
    weightLabel: "Weight range",
    weight: "100–900",
    usage: "Headings, body copy, and interface text",
    mono: false,
  },
  {
    role: "Supporting typeface",
    name: "Fragment Mono",
    description:
      "A precise counterpoint for labels and small moments of technical texture.",
    style: "Monospaced",
    weightLabel: "Weight",
    weight: "400",
    usage: "Compact labels and details",
    mono: true,
  },
] as const;
---

<Layout title={createMetaTitle("Design System")} description={description}>
  <Main>
    <PageHero
      title="A small system for a consistent web."
      description="The type, color, and interface foundations behind this site. A practical reference for the details that keep everything feeling like it belongs together."
    />
    <div class="grid gap-16 md:gap-20">
      <section class="grid gap-6 md:gap-7" aria-labelledby="type-title">
        <div class="grid gap-2">
          <p class={eyebrow}>Typography</p>
          <h2
            id="type-title"
            class={heading({ level: "h4", weight: "medium" })}
          >
            Two typefaces, one clear voice.
          </h2>
        </div>
        <div class="grid gap-8 border-y border-border-soft py-7 md:grid-cols-2 md:gap-10">
          {fontCards.map((font) => (
            <article class="grid content-start gap-5">
              <div class="grid gap-3">
                <p class={cn(label, text({ size: "xs", color: "secondary" }))}>
                  {font.role}
                </p>
                <h3
                  class={cn(
                    heading({ level: "h3", weight: "medium" }),
                    font.mono && "font-mono",
                  )}
                >
                  {font.name}
                </h3>
                <p class={text({ size: "sm", color: "secondary" })}>
                  {font.description}
                </p>
              </div>
              <dl
                class={cn(
                  "grid gap-x-8 gap-y-4 sm:grid-cols-2",
                  text({ size: "sm" }),
                )}
              >
                <div>
                  <dt class={text({ size: "xs", color: "secondary" })}>
                    Style
                  </dt>
                  <dd class={text({ size: "sm", weight: "medium" })}>
                    {font.style}
                  </dd>
                </div>
                <div>
                  <dt class={text({ size: "xs", color: "secondary" })}>
                    {font.weightLabel}
                  </dt>
                  <dd class={text({ size: "sm", weight: "medium" })}>
                    {font.weight}
                  </dd>
                </div>
                <div class="sm:col-span-2">
                  <dt class={text({ size: "xs", color: "secondary" })}>
                    Used for
                  </dt>
                  <dd class={text({ size: "sm", weight: "medium" })}>
                    {font.usage}
                  </dd>
                </div>
                <div class="sm:col-span-2">
                  <dt class={text({ size: "xs", color: "secondary" })}>
                    Character set
                  </dt>
                  <dd
                    class={cn(
                      text({ size: "sm" }),
                      "break-all",
                      font.mono && "font-mono",
                    )}
                  >
                    {characterSet.map((line) => (
                      <>
                        {line}
                        <br />
                      </>
                    ))}
                  </dd>
                </div>
              </dl>
            </article>
          ))}
        </div>
        <div class="divide-y divide-border-soft">
          {typeSamples.map((item) => (
            <div class="grid gap-3 py-6 first:pt-2">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                <p class={text({ size: "sm", weight: "medium" })}>
                  {item.name}
                </p>
                <p
                  class={cn(
                    text({ size: "xs", color: "secondary" }),
                    "font-mono",
                  )}
                >
                  {item.detail}
                </p>
              </div>
              <p
                class={
                  "level" in item
                    ? heading({
                        level: item.level,
                        weight:
                          item.level === "h1" || item.level === "h2"
                            ? "regular"
                            : "medium",
                      })
                    : text({
                        size: item.textSize,
                        lineHeight: item.textSize === "sm" ? "small" : null,
                      })
                }
              >
                {item.sample}
              </p>
            </div>
          ))}
        </div>
      </section>

      <section class="grid gap-6 md:gap-7" aria-labelledby="colors-title">
        <div class="grid gap-2">
          <p class={eyebrow}>Color</p>
          <h2
            id="colors-title"
            class={heading({ level: "h4", weight: "medium" })}
          >
            A little color goes a long way.
          </h2>
          <p class={`${text({ size: "sm", color: "secondary" })} max-w-2xl`}>
            Cobalt carries interactive moments. Neutrals do the quieter work.
            The semantic colors adapt automatically when the site switches
            themes.
          </p>
        </div>
        <div class="divide-y divide-border-soft border-y border-border-soft">
          {palettes.map((palette) => (
            <article class="py-7 first:pt-6">
              <div class="mb-5 grid gap-1.5">
                <h3 class={text({ size: "default", weight: "medium" })}>
                  {palette.name}
                </h3>
                <p class={text({ size: "sm", color: "secondary" })}>
                  {palette.description}
                </p>
              </div>
              <div class="grid grid-cols-4 gap-x-3 gap-y-4 sm:grid-cols-6 lg:grid-cols-11">
                {palette.shades.map(([shade, hex]) => (
                  <div class="min-w-0">
                    <div
                      class="aspect-square rounded-lg border border-black/5"
                      style={`background:${hex}`}
                    ></div>
                    <p
                      class={cn(
                        text({ size: "xs", color: "secondary" }),
                        "mt-2 font-mono",
                      )}
                    >
                      {shade}
                    </p>
                    <p
                      class={cn(
                        text({ size: "xs", color: "secondary" }),
                        "font-mono",
                      )}
                    >
                      {hex}
                    </p>
                  </div>
                ))}
              </div>
            </article>
          ))}
        </div>
        <div class="grid sm:grid-cols-2 sm:gap-x-8">
          {semanticColors.map(({ name, token, palette, usage }) => (
            <article class="grid content-start gap-3 border-b border-border-soft py-5 last:border-b-0 sm:[&:nth-last-child(-n+2)]:border-b-0">
              <div class="flex items-start gap-4">
                <div
                  class="size-14 shrink-0 rounded-xl border border-black/10"
                  style={`background:var(${token})`}
                  aria-hidden="true"
                ></div>
                <div>
                  <h3 class={text({ size: "lg", weight: "medium" })}>{name}</h3>
                  <p class={text({ size: "sm", color: "secondary" })}>
                    {usage}
                  </p>
                  <p
                    class={cn(
                      text({ size: "xs", color: "secondary" }),
                      "font-mono mt-1.5",
                    )}
                  >
                    {palette}
                  </p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    </div>
  </Main>
</Layout>
